datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum ContentStatus {
  IDEA
  DRAFTING
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  BLOG
  VIDEO
  INFOGRAPHIC
  SOCIAL_POST
  STORY
  REEL
  PODCAST
  NEWSLETTER
  CAROUSEL
  THREAD
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TWITTER
  LINKEDIN
  FACEBOOK
  THREADS
  PINTEREST
  BLOG
  EMAIL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkspaceRole {
  ADMIN
  CREATIVE_DIRECTOR
  TEAM
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ClientStatus {
  LEAD
  PROSPECT
  ACTIVE
  PAUSED
  CHURNED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum ExpenseCategory {
  ADS
  TOOLS
  FREELANCER
  PRODUCTION
  TRANSPORT
  MEALS
  SOFTWARE
  OTHER
}

enum NotificationType {
  CONTENT_ASSIGNED
  CONTENT_UNASSIGNED
  CONTENT_SUBMITTED
  CONTENT_APPROVED
  CONTENT_REJECTED
  CONTENT_SCHEDULED
  CONTENT_PUBLISHED
  CONTENT_OVERDUE
  CONTENT_REMINDER
  CONTENT_EDITED
  CLIENT_CREATED
  CLIENT_STATUS_CHANGED
  CONTRACT_EXPIRING
  PROJECT_CREATED
  PROJECT_ASSIGNED
  PROJECT_DEADLINE
  PROJECT_COMPLETED
  INVOICE_CREATED
  INVOICE_SENT
  PAYMENT_RECEIVED
  INVOICE_DUE
  INVOICE_OVERDUE
  EXPENSE_RECORDED
  MEMBER_JOINED
  MEMBER_ROLE_CHANGED
  MEMBER_INVITED
  MEMBER_REMOVED
  SYNC_SUCCESS
  SYNC_FAILED
  CONNECTION_EXPIRED
  REPORT_GENERATED
  STORAGE_WARNING
}

enum NotificationPriority {
  URGENT
  IMPORTANT
  NORMAL
  LOW
}

enum GoogleService {
  SHEETS
  DOCS
  DRIVE
}

enum SyncStatus {
  ACTIVE
  PAUSED
  ERROR
  DISCONNECTED
}

enum SyncDirection {
  APP_TO_GOOGLE
  GOOGLE_TO_APP
  TWO_WAY
}

enum DriveFileType {
  IMAGE
  VIDEO
  DOCUMENT
  SPREADSHEET
  PRESENTATION
  PDF
  DESIGN
  OTHER
}

// ==========================================
// MODELS: AUTH
// ==========================================

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime? @map("email_verified")
  image               String?
  password            String?
  telegramChatId      String?   @map("telegram_chat_id")
  telegramUsername    String?   @map("telegram_username")
  telegramConnected   Boolean   @default(false) @map("telegram_connected")
  telegramConnectedAt DateTime? @map("telegram_connected_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @default(now()) @map("updated_at")

  accounts                Account[]
  sessions                Session[]
  ownedWorkspaces         Workspace[]              @relation("WorkspaceOwner")
  workspaceMembers        WorkspaceMember[]
  createdContents         Content[]                @relation("ContentCreator")
  assignedContents        Content[]                @relation("ContentAssignee")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  activityLogs            ActivityLog[]
  clientNotes             ClientNote[]
  projectMembers          ProjectMember[]
  googleConnections       GoogleConnection[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==========================================
// MODELS: WORKSPACE
// ==========================================

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  logoUrl     String?  @map("logo_url")
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @default(now()) @map("updated_at")

  owner             User               @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members           WorkspaceMember[]
  pillars           ContentPillar[]
  contents          Content[]
  campaigns         Campaign[]
  tags              Tag[]
  clients           Client[]
  projects          Project[]
  invoices          Invoice[]
  expenses          Expense[]
  googleConnections GoogleConnection[]
  sheetSyncs        SheetSync[]
  docTemplates      DocTemplate[]
  generatedDocs     GeneratedDoc[]
  driveFolders      DriveFolder[]
  driveFiles        DriveFile[]
  telegramGroups    TelegramGroup[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(TEAM)
  invitedAt   DateTime      @default(now()) @map("invited_at")
  joinedAt    DateTime?     @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ==========================================
// MODELS: CONTENT
// ==========================================

model ContentPillar {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?  @db.Text
  percentage  Int      @default(0)
  color       String   @default("#3B82F6")
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @default(now()) @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contents  Content[]

  @@map("content_pillars")
}

model Content {
  id           String        @id @default(cuid())
  workspaceId  String        @map("workspace_id")
  title        String
  slug         String        @unique
  contentType  ContentType   @map("content_type")
  platform     Platform
  pillarId     String?       @map("pillar_id")
  campaignId   String?       @map("campaign_id")
  clientId     String?       @map("client_id")
  projectId    String?       @map("project_id")
  publishDate  DateTime?     @db.Date @map("publish_date")
  publishTime  String?       @map("publish_time") // "HH:mm"
  caption      String?       @db.Text
  notes        String?       @db.Text
  status       ContentStatus @default(IDEA)
  priority     Priority      @default(MEDIUM)
  assignedToId String?       @map("assigned_to_id")
  createdById  String        @map("created_by_id")
  mediaUrls    String[]      @default([]) @map("media_urls")
  sortOrder    Int           @default(0) @map("sort_order")
  isPinned     Boolean       @default(false) @map("is_pinned")
  publishedAt  DateTime?     @map("published_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @default(now()) @map("updated_at")

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pillar     ContentPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  campaign   Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  client     Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo User?          @relation("ContentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User           @relation("ContentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  metrics       ContentMetric[]
  tags          ContentTag[]
  driveFolders  DriveFolder[]
  generatedDocs GeneratedDoc[]
  driveFiles    DriveFile[]
  activities    ActivityLog[]

  @@index([workspaceId, status])
  @@index([workspaceId, publishDate])
  @@index([workspaceId, platform])
  @@index([workspaceId, pillarId])
  @@index([workspaceId, campaignId])
  @@index([workspaceId, clientId])
  @@index([workspaceId, projectId])
  @@index([assignedToId])
  @@index([createdById])
  @@map("contents")
}

model ContentMetric {
  id          String   @id @default(cuid())
  contentId   String   @map("content_id")
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  saves       Int      @default(0)
  reach       Int      @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  views       Int      @default(0)
  watchTime   Int      @default(0) @map("watch_time")
  recordedAt  DateTime @default(now()) @map("recorded_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([recordedAt])
  @@map("content_metrics")
}

// ==========================================
// MODELS: CAMPAIGN
// ==========================================

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  clientId    String?        @map("client_id")
  projectId   String?        @map("project_id")
  name        String
  slug        String         @unique
  description String?        @db.Text
  goal        String?        @db.Text
  startDate   DateTime       @db.Date @map("start_date")
  endDate     DateTime       @db.Date @map("end_date")
  status      CampaignStatus @default(PLANNING)
  color       String         @default("#8B5CF6")
  budget      Decimal?       @db.Decimal(12, 2)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @default(now()) @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contents  Content[]

  @@index([workspaceId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("campaigns")
}

// ==========================================
// MODELS: TAG
// ==========================================

model Tag {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  category    String?
  usageCount  Int      @default(0) @map("usage_count")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contents  ContentTag[]

  @@unique([workspaceId, name])
  @@map("tags")
}

model ContentTag {
  contentId String @map("content_id")
  tagId     String @map("tag_id")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@map("content_tags")
}

// ==========================================
// MODELS: CRM
// ==========================================

model Client {
  id              String       @id @default(cuid())
  workspaceId     String       @map("workspace_id")
  name            String
  slug            String       @unique
  industry        String?
  website         String?
  logoUrl         String?      @map("logo_url")
  status          ClientStatus @default(LEAD)
  contractStart   DateTime?    @db.Date @map("contract_start")
  contractEnd     DateTime?    @db.Date @map("contract_end")
  monthlyRetainer Decimal?     @db.Decimal(12, 2) @map("monthly_retainer")
  source          String?
  notes           String?      @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @default(now()) @map("updated_at")

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts      ClientContact[]
  projects      Project[]
  contents      Content[]
  campaigns     Campaign[]
  invoices      Invoice[]
  expenses      Expense[]
  clientNotes   ClientNote[]
  sheetSyncs    SheetSync[]
  generatedDocs GeneratedDoc[]
  driveFolders  DriveFolder[]

  @@index([workspaceId])
  @@index([status])
  @@map("clients")
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String  @map("client_id")
  name      String
  position  String?
  email     String?
  phone     String?
  whatsapp  String?
  isPrimary Boolean @default(false) @map("is_primary")
  notes     String? @db.Text

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_contacts")
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  authorId  String   @map("author_id")
  title     String?
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@map("client_notes")
}

// ==========================================
// MODELS: PROJECT
// ==========================================

model Project {
  id           String        @id @default(cuid())
  workspaceId  String        @map("workspace_id")
  clientId     String        @map("client_id")
  name         String
  slug         String        @unique
  description  String?       @db.Text
  startDate    DateTime      @db.Date @map("start_date")
  endDate      DateTime      @db.Date @map("end_date")
  budget       Decimal?      @db.Decimal(12, 2)
  status       ProjectStatus @default(PLANNING)
  deliverables Json?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @default(now()) @map("updated_at")

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  members       ProjectMember[]
  contents      Content[]
  campaigns     Campaign[]
  invoices      Invoice[]
  expenses      Expense[]
  sheetSyncs    SheetSync[]
  generatedDocs GeneratedDoc[]
  driveFolders  DriveFolder[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  userId    String  @map("user_id")
  role      String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ==========================================
// MODELS: FINANCE
// ==========================================

model Invoice {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  clientId    String        @map("client_id")
  projectId   String?       @map("project_id")
  invoiceNo   String        @unique @map("invoice_no")
  title       String
  issueDate   DateTime      @db.Date @map("issue_date")
  dueDate     DateTime      @db.Date @map("due_date")
  subtotal    Decimal       @db.Decimal(12, 2)
  tax         Decimal       @default(0) @db.Decimal(12, 2)
  discount    Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(DRAFT)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @default(now()) @map("updated_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  payments  Payment[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2) @map("unit_price")
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String   @map("invoice_id")
  amount    Decimal  @db.Decimal(12, 2)
  method    String
  reference String?
  paidAt    DateTime @db.Date @map("paid_at")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

model Expense {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  clientId    String?         @map("client_id")
  projectId   String?         @map("project_id")
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @db.Date
  receiptUrl  String?         @map("receipt_url")
  notes       String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([clientId])
  @@index([projectId])
  @@map("expenses")
}

// ==========================================
// MODELS: GOOGLE INTEGRATIONS
// ==========================================

model GoogleConnection {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  workspaceId    String   @map("workspace_id")
  googleAccountId String  @map("google_account_id")
  googleEmail    String   @map("google_email")
  accessToken    String   @db.Text @map("access_token")
  refreshToken   String   @db.Text @map("refresh_token")
  tokenExpiry    DateTime @map("token_expiry")
  scopes         String[]
  isActive       Boolean  @default(true) @map("is_active")
  connectedAt    DateTime @default(now()) @map("connected_at")
  lastSyncAt     DateTime? @map("last_sync_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("google_connections")
}

model SheetSync {
  id             String        @id @default(cuid())
  workspaceId    String        @map("workspace_id")
  clientId       String?       @map("client_id")
  projectId      String?       @map("project_id")
  spreadsheetId  String        @map("spreadsheet_id")
  spreadsheetUrl String        @map("spreadsheet_url")
  sheetName      String        @map("sheet_name")
  syncDirection  SyncDirection @default(APP_TO_GOOGLE) @map("sync_direction")
  syncStatus     SyncStatus    @default(ACTIVE) @map("sync_status")
  lastSyncAt     DateTime?     @map("last_sync_at")
  lastError      String?       @db.Text @map("last_error")
  config         Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @default(now()) @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("sheet_syncs")
}

model DocTemplate {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  type        String // brief|report|proposal|invoice_cover
  templateId  String?  @map("template_id")
  content     String?  @db.Text
  variables   String[]
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @default(now()) @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatedDocs GeneratedDoc[]

  @@map("doc_templates")
}

model GeneratedDoc {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  templateId  String?  @map("template_id")
  clientId    String?  @map("client_id")
  projectId   String?  @map("project_id")
  contentId   String?  @map("content_id")
  title       String
  docId       String   @map("doc_id")
  docUrl      String   @map("doc_url")
  type        String
  generatedBy String   @map("generated_by")
  data        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  DocTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  client    Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  content   Content?     @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@map("generated_docs")
}

model DriveFolder {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  clientId        String?  @map("client_id")
  projectId       String?  @map("project_id")
  folderId        String   @map("folder_id")
  folderUrl       String   @map("folder_url")
  name            String
  path            String
  contentId       String?  @map("content_id")
  parentId        String?  @map("parent_id")
  sharedWith      String?  @map("shared_with")
  sharePermission String?  @map("share_permission")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  content   Content?      @relation(fields: [contentId], references: [id], onDelete: SetNull)
  parent    DriveFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  DriveFolder[] @relation("FolderTree")
  files     DriveFile[]

  @@map("drive_folders")
}

model DriveFile {
  id           String        @id @default(cuid())
  workspaceId  String        @map("workspace_id")
  folderId     String?       @map("folder_id")
  contentId    String?       @map("content_id")
  fileId       String        @map("file_id")
  fileUrl      String        @map("file_url")
  webViewLink  String?       @map("web_view_link")
  name         String
  mimeType     String        @map("mime_type")
  fileType     DriveFileType @map("file_type")
  size         Int?
  thumbnailUrl String?       @map("thumbnail_url")
  uploadedBy   String        @map("uploaded_by")
  version      Int           @default(1)
  createdAt    DateTime      @default(now()) @map("created_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder    DriveFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  content   Content?     @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@map("drive_files")
}

// ==========================================
// MODELS: NOTIFICATION
// ==========================================

model Notification {
  id        String               @id @default(cuid())
  userId    String               @map("user_id")
  type      NotificationType
  priority  NotificationPriority @default(NORMAL)
  title     String
  message   String               @db.Text
  isRead    Boolean              @default(false) @map("is_read")
  link      String?
  metadata  Json?
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id              String           @id @default(cuid())
  userId          String           @map("user_id")
  type            NotificationType
  inAppEnabled    Boolean          @default(true) @map("in_app_enabled")
  telegramEnabled Boolean          @default(true) @map("telegram_enabled")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

model TelegramGroup {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  groupId     String   @map("group_id")
  groupName   String   @map("group_name")
  role        WorkspaceRole?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, groupId])
  @@map("telegram_groups")
}

// ==========================================
// MODELS: SYSTEM
// ==========================================

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String?  @map("workspace_id")
  contentId   String?  @map("content_id")
  actorId     String   @map("actor_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  actor   User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([contentId])
  @@index([actorId])
  @@map("activity_logs")
}
